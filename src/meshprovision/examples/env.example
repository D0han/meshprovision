# meshprovision environment configuration.
#
# Copy this file to .env and fill in the values you need:
#     cp .env.example .env
# .env and .env.* are gitignored; never commit real values.
#
# Precedence for every setting: CLI flag > environment variable > config file > default.

# Path to the ODS node database.
# Default: data/nodes_db.ods (relative to the current working directory).
#MESHPROVISION_DB_PATH=data/nodes_db.ods

# Path to the provisioning template.
# Default: config/template.yaml
#MESHPROVISION_TEMPLATE_PATH=config/template.yaml

# Directory for the HTTP TTL disk cache.
# Default: the platform user cache directory resolved by platformdirs.
#MESHPROVISION_CACHE_DIR=.cache/meshprovision

# HTTP cache time-to-live, in seconds.
# Default: 300
#MESHPROVISION_CACHE_TTL=300

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# Default: WARNING
#MESHPROVISION_LOG_LEVEL=WARNING

# REQUIRED — no default is provided, deliberately.
# Your own contact address (email or URL). It is sent as part of the
# User-Agent header on every request to lorastats.pl, whose API requires
# identifiable contact information and bans IP addresses that send
# missing, dummy or third-party contact details.
# Set your OWN address. Whitespace-only values are rejected at startup.
MESHPROVISION_CONTACT=
